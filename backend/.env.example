# OpenWeather API Configuration
# Get your free API key at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database Configuration (PostgreSQL)
# For local PostgreSQL or cloud providers like Neon / Supabase:
# e.g., postgresql://postgres:password@localhost:5432/weather_db
# Or SQLite fallback for quick local testing without PostgreSQL: sqlite:///./weather.db
DATABASE_URL=sqlite:///./weather.db

# Application Configuration
APP_NAME=Weather Information API
APP_ENV=development
DEBUG=True
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
